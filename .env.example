# mongodb+srv://… can fail on Render with querySrv ETIMEOUT (SRV DNS timeout).
# Use Atlas standard URI (mongodb://host:27017,…) + tls & replicaSet from Atlas UI, and/or
# Atlas → Network Access → allow 0.0.0.0/0 while testing.
MONGO_URI=
JWT_SECRET=

# Comma-separated. Required in production for browser access to the API.
# In non-production, http://localhost:5173 (Vite) is always allowed in addition to this list.
# Example: https://your-app.vercel.app,https://www.yoursite.com
CORS_ORIGINS=
TRUST_PROXY=1
ENFORCE_HTTPS=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
