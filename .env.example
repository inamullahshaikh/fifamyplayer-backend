MONGO_URI=
JWT_SECRET=

# Comma-separated browser origins allowed to call the API (e.g. https://your-app.vercel.app).
# Strongly recommended in production. If unset, all origins are allowed (see server warning).
CORS_ORIGINS=

# Set to 1 behind Render/Heroku so rate limits and HTTPS checks see the real client IP.
TRUST_PROXY=1

# In production, reject requests where x-forwarded-proto is not https. Set to 0 to disable.
ENFORCE_HTTPS=

# Optional overrides (defaults are safe for small apps)
# RATE_LIMIT_AUTH_MAX=40
# RATE_LIMIT_API_MAX=800

# Cloudflare R2 (optional — omit to use local ./uploads/avatars)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
