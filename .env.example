# mongodb+srv://… can fail on Render with querySrv ETIMEOUT (SRV DNS timeout).

# Use Atlas standard URI (mongodb://host:27017,…) + tls & replicaSet from Atlas UI, and/or

# Atlas → Network Access → allow 0.0.0.0/0 while testing.

MONGO_URI=

JWT_SECRET=



# Comma-separated. Required in production for browser access to the API.

# In non-production, http://localhost:5173 (Vite) is always allowed in addition to this list.

# Example: https://your-app.vercel.app,https://www.yoursite.com

CORS_ORIGINS=

TRUST_PROXY=1

ENFORCE_HTTPS=



R2_ACCOUNT_ID=

R2_ACCESS_KEY_ID=

R2_SECRET_ACCESS_KEY=

R2_BUCKET_NAME=

R2_PUBLIC_URL=



# --- Transactional email (Nodemailer) — optional ---

# Recommended: Resend, SendGrid, Mailgun, Postmark, etc. (not personal @outlook.com SMTP).

# MAIL_HOST must be set — there is no default host.

#

# --- Resend (https://resend.com) — verify your domain, create API key ---

# MAIL_HOST=smtp.resend.com

# MAIL_PORT=587

# MAIL_SECURE=

# MAIL_USER=resend

# MAIL_PASS=re_xxxxxxxx        # API key

# MAIL_FROM=noreply@yourdomain.com   # must be a verified sender/domain in Resend

#

# --- SendGrid ---

# MAIL_HOST=smtp.sendgrid.net

# MAIL_PORT=587

# MAIL_USER=apikey

# MAIL_PASS=SG.xxxxx            # API key

# MAIL_FROM=noreply@yourdomain.com   # verified sender

#

MAIL_HOST=

MAIL_PORT=587

# true only for port 465 (implicit TLS)

MAIL_SECURE=

MAIL_USER=

MAIL_PASS=

MAIL_FROM=

MAIL_FROM_NAME=VirtualXI

# Shown in HTML emails (optional)

APP_DISPLAY_NAME=VirtualXI

# If true, verifies SMTP on server start

MAIL_VERIFY_ON_START=

# When mail is not configured, log skip on send (default on)

MAIL_LOG_SKIPPED=

# Legacy fallbacks still supported: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, MAIL_FROM_ADDRESS

#

# Microsoft 365 (organizational mail only): enable Authenticated SMTP for the mailbox;

# personal @outlook.com cannot use Exchange admin PowerShell. See https://aka.ms/smtp_auth_disabled


